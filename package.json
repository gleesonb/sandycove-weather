{
  "name": "sandycove-weather",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev --config wrangler.deploy.toml",
    "deploy": "astro build && wrangler deploy --config wrangler.deploy.toml",
    "cf:migrate": "wrangler d1 execute sandycove-weather-db --remote --file=db/migrations/0001_create_observations.sql",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.4",
    "@astrojs/react": "^7.1.2",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.94.5",
    "astro": "^7.4.5",
    "fast-xml-parser": "^5.12.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.0",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@types/node": "25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.125.0"
  }
}
